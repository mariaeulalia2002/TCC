    \CidadeTCC, \DataDefesaTCC.\par
    \vspace{0.6cm}
    \textbf{Coordenação do curso}\par
    \AssinaturaTCC{\CoordenadorTCC}{Coordenação do Curso de Geologia}{Universidade Federal de Santa Catarina}
    \vspace{0.3cm}
    \textbf{Banca examinadora}\par
    \AssinaturaTCC{\OrientadorTCC}{Orientador}{Universidade Federal de Santa Catarina}
    \AssinaturaTCC{\MembroUmTCC}{Membro}{\InstituicaoMembroUm}
    \AssinaturaTCC{\MembroDoisTCC}{Membro}{\InstituicaoMembroDois}
