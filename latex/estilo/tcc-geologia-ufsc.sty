% Lista de equações alimentada por \equationdescription imediatamente após
% cada ambiente equation. A numeração continua sendo produzida pelo amsmath.
\makeatletter
\newcommand{\listofequationsname}{Lista de equações}
\newcommand{\listofequations}{%
  \chapter*{\listofequationsname}%
  \@starttoc{loe}%
}
\newcommand*{\l@equation}{\@dottedtocline{1}{0em}{5.2em}}
\newcommand{\equationdescription}[1]{%
  \addcontentsline{loe}{equation}{\protect\numberline{Equação~\theequation}#1}%
}
% Equações centralizadas, com vírgula antes da numeração entre colchetes.
\renewcommand{\tagform@}[1]{\maketag@@@{,\ [#1]}}
\makeatother

\newenvironment{paisagem}{\begin{landscape}}{\end{landscape}}

\newcommand{\TituloCompletoTCC}{%
  \TituloTCC\ifdefempty{\SubtituloTCC}{}{:\ \SubtituloTCC}%
}

\newcommand{\AssinaturaTCC}[3]{%
  \vspace{1.15cm}
  \noindent\rule{10cm}{0.4pt}\\[-2pt]
  #1\\#2\ifstrempty{#3}{}{\\#3}\par
}

\newcommand{\imprimircapaGeologia}{%
  \begin{capa}
    \centering\OnehalfSpacing
    \includegraphics[width=3.45cm]{logo-ufsc.png}\par
    \vspace{0.35cm}
    {\bfseries\MakeUppercase{\InstituicaoTCC}\par}
    {\MakeUppercase{\CentroTCC}\par}
    {\MakeUppercase{\DepartamentoTCC}\par}
    {\MakeUppercase{\CursoTCC}\par}
    \vfill
    {\MakeUppercase{\AutorTCC}\par}
    \vfill
    {\bfseries\MakeUppercase{\TituloCapaTCC}\par}
    \vfill
    {\MakeUppercase{\CidadeTCC}\par}
    {\AnoTCC\par}
  \end{capa}
}

\newcommand{\imprimirfolhaderostoGeologia}{%
  \begin{titlingpage}
    \centering\OnehalfSpacing
    {\MakeUppercase{\AutorTCC}\par}
    \vfill
    {\bfseries\MakeUppercase{\TituloFolhaRostoTCC}\par}
    \vfill
    \begin{adjustwidth}{8cm}{0cm}
      \SingleSpacing\fontsize{10}{12}\selectfont
      \PreambuloTCC\par\medskip
      Orientador: \OrientadorTCC\par
      \ifdefempty{\CoorientadorTCC}{}{Coorientadores: \CoorientadorTCC\par}
    \end{adjustwidth}
    \vfill
    {\MakeUppercase{\CidadeTCC}\par}
    {\AnoTCC\par}
  \end{titlingpage}
}

\newcommand{\imprimirfichacatalograficaModelo}{%
  \clearpage\thispagestyle{empty}
  \begin{center}
    \textbf{FICHA CATALOGRÁFICA}
  \end{center}
  \vspace{1cm}
  \noindent\textit{Substitua esta página pela ficha catalográfica emitida pelo sistema da Biblioteca Universitária da UFSC. Se a ficha for fornecida em PDF ou imagem, insira-a ocupando a área útil desta página.}
}

\newcommand{\imprimirfolhadeaprovacaoGeologia}{%
  \begin{folhadeaprovacao}
    \centering\OnehalfSpacing
    {\bfseries\AutorTCC\par}
    \vspace{1cm}
    {\bfseries\MakeUppercase{\TituloAprovacaoTCC}\par}
    \vspace{1cm}
    Este Trabalho de Conclusão de Curso foi julgado adequado para a obtenção do título de \GrauTCC\ e aprovado em sua forma final pelo Curso de Graduação em Geologia da Universidade Federal de Santa Catarina.\par
    \vspace{0.5cm}
    \CidadeTCC, \DataDefesaTCC.\par
    \vspace{0.6cm}
    \AssinaturaTCC{\OrientadorTCC}{Orientador}{}
    \AssinaturaTCC{\MembroUmTCC}{\InstituicaoMembroUm}{}
    \AssinaturaTCC{\MembroDoisTCC}{\InstituicaoMembroDois}{}
  \end{folhadeaprovacao}
}

