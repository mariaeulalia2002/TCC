\newcommand{\TextoModelo}[1]{\textcolor{cinzaPlaceholder}{\textit{[#1]}}}
\newcommand{\FonteTCC}[1]{\par\vspace{2pt}{\footnotesize Fonte: #1.}}
\newcommand{\coordenadas}[2]{\mbox{#1; #2}}
\newcommand{\dadoestrutural}[3]{\ensuremath{#1}: \mbox{#2/#3}}
\newcommand{\unidadegeologica}[1]{\textit{#1}}

\newcommand{\figuratcc}[5][0.82\textwidth]{%
  \begin{figure}[H]
    \centering
    \caption{#3}\label{#5}
    \includegraphics[width=#1]{#2}
    \FonteTCC{#4}
  \end{figure}
}

\newcommand{\figuraplaceholder}[4][0.72\textwidth]{%
  \begin{figure}[H]
    \centering
    \caption{#2}\label{#4}
    \fcolorbox{black!45}{cinzaFundo}{%
      \parbox[c][5.2cm][c]{#1}{\centering\color{cinzaPlaceholder}%
      INSIRA AQUI\\[4pt]mapa, perfil, fotografia ou diagrama}}
    \FonteTCC{#3}
  \end{figure}
}

