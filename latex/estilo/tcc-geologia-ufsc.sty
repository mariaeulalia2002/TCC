    \vfill
    {\bfseries\MakeUppercase{\CidadeTCC}\par}
    {\bfseries\AnoTCC\par}
  \end{capa}
}

\newcommand{\imprimirfolhaderostoGeologia}{%
  \begin{titlingpage}
    \centering\OnehalfSpacing
    {\bfseries\MakeUppercase{\AutorTCC}\par}
    \vfill
    {\bfseries\MakeUppercase{\TituloCompletoTCC}\par}
    \vfill
    \begin{adjustwidth}{8cm}{0cm}
      \SingleSpacing\small
      \PreambuloTCC\par\medskip
      Orientador: \OrientadorTCC.\par
