\newcommand{\TituloCompletoTCC}{%
  \TituloTCC\ifstrempty{\SubtituloTCC}{}{:\ \SubtituloTCC}%
}

\newcommand{\AssinaturaTCC}[3]{%
  \vspace{1.15cm}
  \noindent\rule{10cm}{0.4pt}\\[-2pt]
  #1\\#2\\#3
}

